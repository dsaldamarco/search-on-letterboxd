{
  "manifest_version": 3,
  "name": "Search on Letterboxd",
  "version": "1.0",
  "description": "Select a movie title, right-click and search it on Letterboxd.",
  "icons": {
    "16": "icons/letterboxd.svg",
    "32": "icons/letterboxd.svg",
    "48": "icons/letterboxd.svg",
    "96": "icons/letterboxd.svg"
  },
  "permissions": ["menus"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{c5b279e2-e28b-4e4b-9c8d-6100bdc0c534}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
